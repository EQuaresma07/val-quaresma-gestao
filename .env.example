# ============================================
# BANCO DE DADOS
# ============================================
# Local (desenvolvimento): use docker ou postgres local
# Produção (Railway): cole aqui a URL gerada pelo Railway
DATABASE_URL="postgresql://user:password@localhost:5432/atelier?schema=public"

# ============================================
# AUTENTICAÇÃO (JWT)
# ============================================
# IMPORTANTE: gere uma chave segura com: openssl rand -base64 32
# NUNCA commite a chave real! Mantenha em segredo.
JWT_SECRET="troque-isso-por-uma-chave-segura-com-no-minimo-32-caracteres-aleatorios"

# Tempo de expiração do token (em horas)
JWT_EXPIRES_IN_HOURS="12"

# ============================================
# AMBIENTE
# ============================================
NODE_ENV="development"
